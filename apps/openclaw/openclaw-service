#!/usr/bin/env bash
# Manage OpenClaw as a systemd *user* service on the host.
#
# Usage:
#   openclaw-service [gateway] install|uninstall|status
#   openclaw-service node install [node run flags...] | uninstall | status
#
# The role defaults to `gateway`. A machine runs one or the other, not both:
# a gateway owns the channels and the model; a node is a peripheral paired to
# somebody else's gateway. See `openclaw-node` for what a node actually is.
#
# This works from inside the box without distrobox-host-exec. Distrobox shares
# the host's user runtime dir, so DBUS_SESSION_BUS_ADDRESS already points at
# /run/user/$UID/bus and `systemctl --user` here drives the *host's* user
# manager. $HOME is shared too, so a unit written to ~/.config/systemd/user/ is
# the same file the host manager reads.
#
# Note what that means: the unit runs on the HOST. Every path in it must be a
# host path, which is why ExecStart goes through `distrobox enter` rather than
# naming this container's binaries directly.
set -euo pipefail
# shellcheck source=/dev/null
source /usr/lib/openclaw/bridge.sh
ensure_systemd_bridge

BOX=openclaw-box
UNIT_DIR="${HOME}/.config/systemd/user"

usage() {
    cat >&2 <<'USAGE'
Usage:
  openclaw-service [gateway] install|uninstall|status
  openclaw-service node install [flags for `openclaw node run`] | uninstall | status

Examples:
  openclaw-service install
      Run the Gateway on this machine as a host user service.

  openclaw-service node install --host 192.168.0.10 --port 18789 --display-name "Desk"
      Join this machine to a gateway elsewhere as a node. Pair it first:
      openclaw-node --pair "oc-pair://<setup-code>" --display-name "Desk"

For logs, use: openclaw logs --follow
USAGE
    exit 1
}

role=gateway
case "${1:-}" in
    gateway|node) role="$1"; shift ;;
esac

case "$role" in
    gateway)
        UNIT=openclaw-gateway.service
        DESCRIPTION="OpenClaw Gateway (${BOX})"
        EXEC_BIN=/usr/bin/openclaw-gateway
        ENV_FILE='%h/.openclaw/gateway.env'
        ENV_FILE_HINT="${HOME}/.openclaw/gateway.env"
        ;;
    node)
        UNIT=openclaw-node.service
        DESCRIPTION="OpenClaw node host (${BOX})"
        EXEC_BIN=/usr/bin/openclaw-node
        ENV_FILE='%h/.openclaw/node.env'
        ENV_FILE_HINT="${HOME}/.openclaw/node.env"
        ;;
esac
UNIT_PATH="${UNIT_DIR}/${UNIT}"

# /run/host is the host's root, mounted read-only in every distrobox. distrobox
# itself is commonly installed to /usr/local/bin (a curl|bash install) rather
# than /usr/bin (a distro package), so probe rather than hardcode.
find_host_distrobox() {
    local p
    for p in /usr/local/bin/distrobox /usr/bin/distrobox; do
        [[ -x "/run/host${p}" ]] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

# Lingering is what lets a user service start at boot and survive logout. It is
# a file under /var/lib/systemd/linger, so it can be read straight off the
# mounted host root -- no system bus, no polkit, no host-exec.
linger_enabled() {
    [[ -e "/run/host/var/lib/systemd/linger/${USER}" ]]
}

# systemd splits ExecStart on whitespace unless arguments are quoted, so every
# passed-through flag value (--display-name "Build Node") has to be quoted here.
#
# Quoting is not enough on its own: systemd expands %-specifiers inside quoted
# arguments too, so a display name containing "%n" would arrive as the unit's
# name rather than as itself. "%%" is the literal percent.
systemd_quote() {
    local a="$1"
    a="${a//\\/\\\\}"
    a="${a//\"/\\\"}"
    a="${a//%/%%}"
    printf '"%s"' "$a"
}

cmd_install() {
    local distrobox_path
    if ! distrobox_path="$(find_host_distrobox)"; then
        echo "openclaw-service: cannot find distrobox on the host." >&2
        echo "  Looked for /usr/local/bin/distrobox and /usr/bin/distrobox." >&2
        exit 1
    fi

    local exec_args="" a
    for a in "$@"; do
        exec_args+=" $(systemd_quote "$a")"
    done

    # A single-use pair code expires in ten minutes, so baking one into a unit
    # that restarts on failure is never what the user wants.
    for a in "$@"; do
        if [[ "$a" == --pair || "$a" == --pair=* ]]; then
            echo "openclaw-service: --pair codes are single-use and expire in 10 minutes;" >&2
            echo "  they do not belong in a service unit. Pair once in the foreground:" >&2
            echo "      openclaw-node --pair \"oc-pair://<setup-code>\"" >&2
            echo "  then install the service with --host/--port." >&2
            exit 1
        fi
    done

    if [[ "$role" == node && "$*" != *--host* ]]; then
        echo "Note: no --host given; the node will use gateway.remote.url from your config."
    fi

    mkdir -p "$UNIT_DIR"
    cat > "$UNIT_PATH" <<UNITEOF
# Generated by openclaw-service. Runs on the host; enters ${BOX} to start
# OpenClaw, so all paths here are host paths.
[Unit]
Description=${DESCRIPTION}
# After= without a matching ordering back from default.target is not a cycle:
# Wants= carries no ordering of its own, so default.target is *not* ordered
# after the units in its .wants. Verified on systemd 255 with this very unit
# enabled -- `systemctl --user show default.target -p After` lists basic.target
# alone, and with lingering on, the gateway entered active in the same second
# as the user manager on a cold boot.
After=default.target

[Service]
Type=simple
# Optional: put OPENCLAW_GATEWAY_TOKEN, OPENCLAW_BIND, OPENCLAW_GATEWAY_PORT etc.
# here rather than inline, so secrets stay out of the unit file.
EnvironmentFile=-${ENV_FILE}
ExecStart=${distrobox_path} enter -T -nw -n ${BOX} -- ${EXEC_BIN}${exec_args}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNITEOF
    echo "==> Wrote ${UNIT_PATH}"

    systemctl --user daemon-reload
    systemctl --user enable "$UNIT"
    # restart, not `enable --now`: install doubles as reconfigure (new --host,
    # --port, --display-name), and `--now` only *starts* the unit, which is a
    # no-op when it is already running. The rewritten ExecStart would then be
    # reported as started while the old process kept the old arguments.
    systemctl --user restart "$UNIT"
    echo "==> Enabled and (re)started ${UNIT}"
    echo "    Environment file (optional): ${ENV_FILE_HINT}"

    if ! linger_enabled; then
        echo
        echo "Note: lingering is off, so this will not start at boot or survive logout."
        echo "  Run this on the HOST, once:  loginctl enable-linger ${USER}"
    fi
}

cmd_uninstall() {
    systemctl --user disable --now "$UNIT" 2>/dev/null || true
    rm -f "$UNIT_PATH"
    systemctl --user daemon-reload
    echo "==> Removed ${UNIT}"
}

cmd_status() {
    systemctl --user status "$UNIT" --no-pager || true
    linger_enabled || echo "Lingering: off (run 'loginctl enable-linger ${USER}' on the host)"
}

action="${1:-}"
[[ $# -gt 0 ]] && shift
case "$action" in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    status)    cmd_status ;;
    *)         usage ;;
esac
