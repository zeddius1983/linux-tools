#!/usr/bin/env bash
# Runs only while building the image; no host operations or GPU required.
set -euo pipefail
git clone https://github.com/Zagitta/gpu-unlock.git /opt/gpu-unlock-src
git -C /opt/gpu-unlock-src checkout --detach 6081407b312aa3139a2bed62bdda354f4ffddc1d

make -C /opt/gpu-unlock-src inputs INPUTS=/tmp/gpu-unlock-inputs
(
    cd /tmp/gpu-unlock-inputs
    sha256sum -c <<'SUMS'
7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc  NVIDIA-kernel-module-source-610.43.03.tar.xz
e084451db730a6df29d3d74f655749c4d236e3c945f7d94b5205e84318fe2f90  NVIDIA-Linux-x86_64-610.43.03-no-compat32.run
SUMS
)
make -C /opt/gpu-unlock-src firmware INPUTS=/tmp/gpu-unlock-inputs ASSETS=/opt/gpu-unlock-assets
make -C /opt/gpu-unlock-src install-firmware install-licenses \
    ASSETS=/opt/gpu-unlock-assets DESTDIR=/opt/gpu-unlock-payload
rm -rf /tmp/gpu-unlock-inputs /opt/gpu-unlock-assets /opt/gpu-unlock-assets.src

# A fixed Python also works on rolling Arch hosts after their system Python
# advances past the wheels supported by this pinned PyTorch release.
uv python install 3.12.12
uv venv --python 3.12.12 /opt/gpu-unlock-venv
uv pip install --python /opt/gpu-unlock-venv/bin/python numpy==2.2.6
uv pip install --python /opt/gpu-unlock-venv/bin/python \
    torch==2.8.0 --index-url https://download.pytorch.org/whl/cu128
uv cache clean
