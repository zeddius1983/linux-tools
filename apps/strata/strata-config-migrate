#!/usr/bin/env bash
# Strata writes the absolute Terminal version into generated run manifests.
# linux-tools replaces the whole container on `tools setup`, so that versioned
# directory disappears while these files survive in Distrobox's shared $HOME.
# Point packaging-owned paths at upstream's stable `current` symlink without
# disturbing model data or user-added settings in the same JSON files.

set -uo pipefail

readonly terminal_pattern='/opt/strata/terminal/[0-9][0-9A-Za-z._+-]*'
readonly terminal_current='/opt/strata/terminal/current'
readonly data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly state_home="${XDG_STATE_HOME:-$HOME/.local/state}"

status=0

migrate_file() {
    local file="$1" tmp
    grep -Eq "$terminal_pattern" "$file" 2>/dev/null || return 0

    # Keep the temporary file beside its target so the final rename is atomic.
    tmp="${file}.linux-tools.tmp.$$"
    if ! sed -E "s#${terminal_pattern}#${terminal_current}#g" "$file" > "$tmp"; then
        rm -f -- "$tmp"
        printf 'strata: could not migrate stale Terminal paths in %s\n' "$file" >&2
        return 1
    fi
    if ! chmod --reference="$file" "$tmp" || ! mv -f -- "$tmp" "$file"; then
        rm -f -- "$tmp"
        printf 'strata: could not replace migrated manifest %s\n' "$file" >&2
        return 1
    fi
}

scan_install_manifests() {
    local dir="$data_home/strata/install" file
    [[ -d "$dir" ]] || return 0
    while IFS= read -r -d '' file; do
        migrate_file "$file" || status=1
    done < <(find "$dir" -maxdepth 1 -type f \
        \( -name 'strata-*.json' -o -name 'strata-*.json.bak' -o -name 'run-*.sh' \) -print0)
}

scan_launch_manifests() {
    local dir="$state_home/strata/launch" file
    [[ -d "$dir" ]] || return 0
    while IFS= read -r -d '' file; do
        migrate_file "$file" || status=1
    done < <(find "$dir" -maxdepth 1 -type f \
        \( -name '*.json' -o -name '*.json.bak' \) -print0)
}

scan_install_manifests
scan_launch_manifests
exit "$status"
