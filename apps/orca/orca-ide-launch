#!/usr/bin/env bash
# Desktop launcher for Orca: the package's orca-ide.desktop is pointed here
# (see the Dockerfile) so opening Orca from the menu also brings up orca-tray.
#
# Orca keeps its terminals in a background daemon that outlives the window, and
# on Linux it shows no tray icon of its own, so after closing the window there
# is nothing on screen saying sessions are still running and no way to stop
# them short of the menu's "Quit Completely…". The tray is that indicator.
#
# Best effort on purpose: a desktop with no StatusNotifier host, or a missing
# indicator library, must not stop Orca from opening. orca-tray takes a lock
# and exits quietly if one is already running.
#
# SHELL points Orca's terminals at the host: with no Custom shell set in Orca's
# settings it falls back to $SHELL, so this is a default that the setting still
# overrides (set it to /bin/bash to get in-box terminals). Exported before the
# tray starts, so the tray's "Open Orca" inherits it too.
export SHELL=/usr/bin/orca-host-shell

setsid /usr/bin/orca-tray >/dev/null 2>&1 &
disown 2>/dev/null || true

exec /opt/Orca/orca-ide "$@"
