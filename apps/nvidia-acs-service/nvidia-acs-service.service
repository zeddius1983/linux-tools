[Unit]
Description=Disable PCIe ACS redirect above the P2P GPUs (enables switch-local P2P)
After=systemd-modules-load.service
ConditionPathExists=/usr/bin/setpci

[Service]
Type=oneshot
RemainAfterExit=yes
# GPU PCI IDs the script targets; override here for a different clique.
Environment=P2P_GPU_PCI_IDS=10de:2204
ExecStart=/usr/local/sbin/nvidia-acs-service.sh

[Install]
WantedBy=multi-user.target
