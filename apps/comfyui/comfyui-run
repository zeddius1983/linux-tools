#!/usr/bin/env bash
# ComfyUI launcher (exported to the host as `comfyui`).
#
# The GPU backend is fixed at image-build time by wizard/00-gpu.runtime and
# recorded in /etc/comfyui-gpu, so this script only has to branch on the tuning
# that actually differs between ROCm and CUDA.
set -euo pipefail

export VIRTUAL_ENV=/opt/venv
export PATH="/opt/venv/bin:${PATH}"

gpu="$(cat /etc/comfyui-gpu 2>/dev/null || echo amd)"

# Models live in the shared host $HOME (see extra_model_paths.yaml) so they
# survive image rebuilds and are shared across AMD/NVIDIA variants.
mkdir -p "${HOME}/.comfyui/models"/{checkpoints,vae,loras,controlnet,upscale_models,clip,unet,diffusion_models}

declare -a args=(--listen 0.0.0.0)

if [[ "$gpu" == "nvidia" ]]; then
    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
else
    # Strix Halo (gfx1151) tuning — see .memory.md for why each of these matters.
    export PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
    export HSA_ENABLE_SDMA=0
    export TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
    export TORCH_BLAS_PREFER_HIPBLASLT=1
    export MIOPEN_USER_DB_PATH="${HOME}/.cache/miopen"
    mkdir -p "${MIOPEN_USER_DB_PATH}"
    args+=(--reserve-vram 3 --bf16-vae --disable-mmap --cache-none)
fi

# Escape hatch: the defaults above are tuned for unified-memory AMD hardware and
# are the wrong answer on, say, a discrete 8 GB card. COMFYUI_ARGS replaces them
# wholesale (--listen is kept so the server stays reachable from the host).
if [[ -n "${COMFYUI_ARGS:-}" ]]; then
    # Word-splitting is the point: COMFYUI_ARGS holds a flag string.
    # shellcheck disable=SC2206
    args=(--listen 0.0.0.0 ${COMFYUI_ARGS})
fi

echo "ComfyUI (${gpu}) starting — open http://localhost:8188 in your browser"
cd /opt/ComfyUI
exec /opt/venv/bin/python main.py "${args[@]}" "$@"
