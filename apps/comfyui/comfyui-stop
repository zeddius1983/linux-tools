#!/usr/bin/env bash
# Stop a running ComfyUI server (exported to the host as `comfyui-stop`).
#
# Exists because the desktop launcher starts the server detached — there is no
# terminal to Ctrl-C, so without this the only way to stop it is to hunt down
# the PID by hand.
set -euo pipefail

PATTERN="/opt/venv/bin/python main.py"
SERVER_URL="http://localhost:8188"

force=0
case "${1:-}" in
    -f|--force) force=1 ;;
    -h|--help)
        echo "usage: comfyui-stop [-f|--force]"
        echo
        echo "Interrupts the running prompt, then stops the server with SIGINT."
        echo "Refuses to stop while work is queued unless --force is given."
        exit 0
        ;;
    "") ;;
    *)  echo "comfyui-stop: unknown option '$1'" >&2; exit 2 ;;
esac

if ! pgrep -f "$PATTERN" >/dev/null 2>&1; then
    echo "ComfyUI is not running."
    exit 0
fi

# Queued prompts are held in memory and are lost with the process, so a stop
# with work pending destroys it. Say so rather than doing it silently.
if curl -sf "$SERVER_URL/prompt" -o /tmp/.comfyui-queue.$$ 2>/dev/null; then
    queued="$(grep -o '"queue_remaining": *[0-9]*' /tmp/.comfyui-queue.$$ \
        | grep -o '[0-9]*$' || echo 0)"
    rm -f /tmp/.comfyui-queue.$$
    if [[ "${queued:-0}" -gt 0 && $force -eq 0 ]]; then
        echo "ComfyUI has ${queued} prompt(s) queued; they will be lost." >&2
        echo "Wait for them, or re-run: comfyui-stop --force" >&2
        exit 1
    fi
fi

# Interrupt whatever is mid-generation so the process is not signalled partway
# through a sampling step. /interrupt only stops the *running* prompt.
if curl -sf "$SERVER_URL" >/dev/null 2>&1; then
    curl -sf -X POST "$SERVER_URL/interrupt" >/dev/null 2>&1 || true
fi

# SIGINT is preferred: it is what Ctrl-C sends, so Python raises
# KeyboardInterrupt and unwinds normally, while SIGTERM's default action
# terminates the interpreter outright with no cleanup.
#
# But SIGINT is not always deliverable. A server started detached by a
# comfyui-app from before the `set -m` fix inherited SIGINT as SIG_IGN from the
# shell's background-job handling, and CPython keeps that disposition rather
# than installing its handler -- SIGINT is a permanent no-op for those
# processes, silently. So ask the kernel what the process will actually do
# (bit 1 of SigIgn in /proc/<pid>/status) and pick the signal that works.
sigint_ignored() {
    local ign
    ign="$(awk '/^SigIgn:/{print $2}' "/proc/$1/status" 2>/dev/null)"
    [[ -n "$ign" ]] || return 1
    (( 0x${ign} & 0x2 ))
}

echo "Stopping ComfyUI..."
mapfile -t pids < <(pgrep -f "$PATTERN")
for pid in ${pids[@]+"${pids[@]}"}; do
    if sigint_ignored "$pid"; then
        echo "  pid ${pid}: ignores SIGINT (started detached by an older" \
             "launcher) — using SIGTERM"
        kill -TERM "$pid" 2>/dev/null || true
    else
        kill -INT "$pid" 2>/dev/null || true
    fi
done

for _ in $(seq 30); do
    if ! pgrep -f "$PATTERN" >/dev/null 2>&1; then
        echo "ComfyUI stopped."
        exit 0
    fi
    sleep 1
done

echo "Still running after 30s — sending SIGKILL." >&2
pkill -KILL -f "$PATTERN" || true
sleep 2
if pgrep -f "$PATTERN" >/dev/null 2>&1; then
    echo "Error: could not stop ComfyUI." >&2
    exit 1
fi
echo "ComfyUI stopped (forced)."
