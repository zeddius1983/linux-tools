#!/usr/bin/python3
"""System tray icon for ComfyUI (exported to the host as `comfyui-tray`).

Exists because the desktop launcher starts the server detached: there is no
window and no terminal, so once it is running there is nothing to interact with
and no obvious way to stop it. This puts a status indicator and a Stop item in
the notification area.

The shebang is /usr/bin/python3 on purpose and must stay that way. The image
puts /opt/venv/bin first on PATH, so `#!/usr/bin/env python3` would resolve to
the venv interpreter -- which has torch but no `gi`. This process needs the
system interpreter's PyGObject and never needs torch.

Every action shells out to the scripts that already own that behaviour
(comfyui / comfyui-stop / comfyui-open) rather than reimplementing it.
"""

import fcntl
import json
import os
import signal
import subprocess
import sys
import threading
import urllib.error
import urllib.request

import gi

gi.require_version("Gtk", "3.0")
# Ayatana is the maintained fork and what Ubuntu 24.04 ships; the older
# AppIndicator3 name is still what some desktops provide.
try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator
except (ValueError, ImportError):
    gi.require_version("AppIndicator3", "0.1")
    from gi.repository import AppIndicator3 as AppIndicator

from gi.repository import GLib, Gtk  # noqa: E402

SERVER_URL = "http://localhost:8188"
ICON_DIR = "/usr/share/comfyui"
LOG_FILE = os.path.expanduser("~/.comfyui/server.log")
LOCK_FILE = os.path.expanduser("~/.comfyui/tray.lock")
POLL_SECONDS = 3


def single_instance():
    """Hold a lock for the session, or exit if another tray already has it.

    The lock fd is intentionally leaked: it must stay open for the process
    lifetime, and the kernel drops it on exit however we die.
    """
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("comfyui-tray: already running", file=sys.stderr)
        sys.exit(0)
    return fd


def server_state():
    """(running, queued). queued is None when the server did not answer."""
    try:
        with urllib.request.urlopen(f"{SERVER_URL}/prompt", timeout=2) as r:
            info = json.load(r).get("exec_info", {})
            return True, info.get("queue_remaining", 0)
    except (urllib.error.URLError, OSError, ValueError):
        return False, None


def run_detached(argv):
    subprocess.Popen(
        argv,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


class Tray:
    def __init__(self):
        self.indicator = AppIndicator.Indicator.new_with_path(
            "comfyui",
            "comfyui",
            AppIndicator.IndicatorCategory.APPLICATION_STATUS,
            ICON_DIR,
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title("ComfyUI")

        self.menu = Gtk.Menu()
        self.item_status = Gtk.MenuItem(label="Checking…")
        self.item_status.set_sensitive(False)
        self.item_open = Gtk.MenuItem(label="Open in browser")
        self.item_open.connect("activate", self.on_open)
        self.item_toggle = Gtk.MenuItem(label="Start server")
        self.item_toggle.connect("activate", self.on_toggle)
        self.item_log = Gtk.MenuItem(label="Show log")
        self.item_log.connect("activate", self.on_log)
        self.item_quit = Gtk.MenuItem(label="Quit tray")
        self.item_quit.connect("activate", lambda *_: Gtk.main_quit())

        for item in (
            self.item_status,
            Gtk.SeparatorMenuItem(),
            self.item_open,
            self.item_toggle,
            self.item_log,
            Gtk.SeparatorMenuItem(),
            self.item_quit,
        ):
            self.menu.append(item)
        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        self.running = False
        self.busy = False
        self.refresh()
        GLib.timeout_add_seconds(POLL_SECONDS, self.refresh)

    # --- state ---------------------------------------------------------------

    def refresh(self):
        if self.busy:
            return True
        running, queued = server_state()
        self.running = running
        if running:
            label = "Server: running"
            if queued:
                label += f" ({queued} queued)"
        else:
            label = "Server: stopped"
        self.item_status.set_label(label)
        self.item_toggle.set_label("Stop server" if running else "Start server")
        self.item_open.set_sensitive(running)
        self.indicator.set_label("" if running else "", "ComfyUI")
        return True  # keep the timeout armed

    def set_busy(self, busy, label=None):
        self.busy = busy
        self.item_toggle.set_sensitive(not busy)
        if label:
            self.item_status.set_label(label)

    # --- actions -------------------------------------------------------------

    def on_open(self, *_):
        run_detached(["/usr/bin/comfyui-open"])

    def on_log(self, *_):
        run_detached(["distrobox-host-exec", "xdg-open", LOG_FILE])

    def on_toggle(self, *_):
        if self.running:
            self.stop(force=False)
        else:
            self.start()

    def start(self):
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        log = open(LOG_FILE, "ab")
        # start_new_session detaches it from the tray, so quitting the tray does
        # not take the server with it. Signal dispositions are left at their
        # defaults, which is what keeps the server killable with SIGINT -- see
        # the `set -m` note in comfyui-app.
        subprocess.Popen(
            ["/usr/bin/comfyui"],
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        self.set_busy(True, "Server: starting…")
        GLib.timeout_add_seconds(2, self._clear_busy)

    def _clear_busy(self):
        self.set_busy(False)
        self.refresh()
        return False

    def stop(self, force):
        """Run comfyui-stop off the main loop so the menu never freezes."""
        self.set_busy(True, "Server: stopping…")
        argv = ["/usr/bin/comfyui-stop"] + (["--force"] if force else [])

        def worker():
            proc = subprocess.run(argv, capture_output=True, text=True)
            GLib.idle_add(self._stopped, proc.returncode, proc.stderr)

        threading.Thread(target=worker, daemon=True).start()

    def _stopped(self, rc, stderr):
        self.set_busy(False)
        self.refresh()
        # comfyui-stop refuses while prompts are queued rather than destroying
        # them silently. Surface that as a choice instead of a dead menu click.
        if rc != 0 and "queued" in (stderr or ""):
            dialog = Gtk.MessageDialog(
                transient_for=None,
                modal=True,
                message_type=Gtk.MessageType.WARNING,
                buttons=Gtk.ButtonsType.NONE,
                text="ComfyUI still has queued prompts",
            )
            dialog.format_secondary_text(
                stderr.strip() + "\n\nStopping now discards them."
            )
            dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
            dialog.add_button("Stop anyway", Gtk.ResponseType.OK)
            response = dialog.run()
            dialog.destroy()
            if response == Gtk.ResponseType.OK:
                self.stop(force=True)
        elif rc != 0:
            print(f"comfyui-tray: stop failed: {stderr}", file=sys.stderr)
        return False


def main():
    single_instance()
    # Let Ctrl-C work when the tray is run from a terminal; GTK would otherwise
    # swallow it.
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()
