setup,build
arg|LLAMA_REF
items-cmd|{ printf '%s\n' latest; git ls-remote --tags --refs https://github.com/ggml-org/llama.cpp 'v*' | sed 's@.*refs/tags/@@' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -10 | tac; }
